[Unit]
Description=Academio AI Engine service (FastAPI/uvicorn)
After=network.target postgresql.service

[Service]
Type=simple
User=academio
Group=academio
Restart=always
RestartSec=5s
WorkingDirectory=/opt/academio-ai/current
EnvironmentFile=-/opt/academio-ai/.env
ExecStart=/opt/academio-ai/current/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
StandardOutput=journal
StandardError=journal
SyslogIdentifier=academio-ai

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/academio/uploads
ProtectHome=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
