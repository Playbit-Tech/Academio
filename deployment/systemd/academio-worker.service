[Unit]
Description=Academio Worker service (Asynq queue + cron scheduler)
After=network.target postgresql.service redis-server.service academio.service

[Service]
Type=simple
User=academio
Group=academio
Restart=always
RestartSec=5s
WorkingDirectory=/var/www/academio
EnvironmentFile=/var/www/academio/.env
# Force worker role regardless of the shared .env — systemd Environment=
# directives take precedence over EnvironmentFile values.
Environment=APP_ROLE=worker
ExecStart=/var/www/academio/worker
StandardOutput=journal
StandardError=journal
SyslogIdentifier=academio-worker

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/academio/uploads
ProtectHome=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
